#include <stdio.h>
int main()
{
    int pageTable[20];
    int n, pageSize, pageNo, offset;
    int frameNo, physicalAddress;
    printf("Enter number of pages: ");
    scanf("%d",&n);
    printf("Enter page size: ");
    scanf("%d",&pageSize);
    printf("Enter frame number for each page:\n");
    for(int i=0;i<n;i++)
    {
        printf("Page %d : ",i);
        scanf("%d",&pageTable[i]);
    }
    printf("Enter Page Number: ");
    scanf("%d",&pageNo);
    printf("Enter Offset: ");
    scanf("%d",&offset);
    if(pageNo>=0 && pageNo<n && offset<pageSize)
    {
        frameNo=pageTable[pageNo];
        physicalAddress=(frameNo*pageSize)+offset;
        printf("\nFrame Number = %d",frameNo);
        printf("\nPhysical Address = %d\n",physicalAddress);
    }
    else
    {
        printf("\nInvalid Page Number or Offset\n");
    }
    return 0;
}


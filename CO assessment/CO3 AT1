PROGRAM 3 : 

#include <stdio.h>
int main()
{
    int pageTable[20];
    int pages,pageNo;
    printf("Enter number of pages: ");
    scanf("%d",&pages);
    printf("Enter Frame Number for each Page:\n");
    for(int i=0;i<pages;i++)
    {
        printf("Page %d -> Frame : ",i);
        scanf("%d",&pageTable[i]);
    }
    printf("Enter Logical Page Number: ");
    scanf("%d",&pageNo);
    if(pageNo>=0 && pageNo<pages)
        printf("\nLogical Page %d maps to Frame %d\n",pageNo,pageTable[pageNo]);
    else
        printf("\nInvalid Page Number\n");
    return 0;
}

